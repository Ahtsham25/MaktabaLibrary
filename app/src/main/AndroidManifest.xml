<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MaktabaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MaktabaLibrary"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MaktabaLibrary.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AuthorBooksActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BookOptionsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PdfReaderActivity"
            android:exported="false" />

        <activity
            android:name=".ui.OnlineReaderActivity"
            android:exported="false" />

        <activity
            android:name=".ui.WebPageActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CrashLogsActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
