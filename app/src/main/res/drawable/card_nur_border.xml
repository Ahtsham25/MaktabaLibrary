<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_black" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="sweep"
                android:startColor="@color/gold_deep"
                android:centerColor="@color/gold_glow"
                android:endColor="@color/gold_deep"
                android:useLevel="false" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:left="1.2dp"
        android:top="1.2dp"
        android:right="1.2dp"
        android:bottom="1.2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_black" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
